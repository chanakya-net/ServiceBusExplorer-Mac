<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control styling. Everything resolves through the tokens in Theme.axaml, so there are
    no literal colours here and light/dark need no separate rules.
  -->

  <Style Selector="Window">
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- ══════════════════════════════ typography ══════════════════════════════ -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Section captions: small, uppercase, wide-tracked. -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="LetterSpacing" Value="0.7" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
  </Style>

  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
  </Style>

  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
  </Style>

  <!-- ═══════════════════════════════ buttons ═══════════════════════════════ -->

  <!-- Toolbar buttons read as one surface until hovered. -->
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource PadTight}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.toolbar /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="Button.toolbar:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
  </Style>

  <!-- Disabled toolbar buttons fade rather than greying to a different hue. -->
  <Style Selector="Button.toolbar:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Destructive actions tint their icon and label. -->
  <Style Selector="Button.destructive">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <!-- Filled primary button, for the default action in dialogs. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource PadControl}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Neutral bordered button, for Cancel and secondary actions. -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource PadControl}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
  </Style>

  <Style Selector="Button.secondary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!--
    Toggle that matches the toolbar buttons when off, and fills with the danger tint when
    on — the dead-letter view is a mode, so it needs to be obvious at a glance which one
    you're looking at. The Fluent ToggleButton template paints its own chrome, so the
    background is set on the ContentPresenter rather than the control.
  -->
  <Style Selector="ToggleButton.toolbarToggle">
    <Setter Property="Padding" Value="{StaticResource PadTight}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.toolbarToggle /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
  </Style>

  <Style Selector="ToggleButton.toolbarToggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="ToggleButton.toolbarToggle:checked">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="ToggleButton.toolbarToggle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="ToggleButton.toolbarToggle:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="ToggleButton.toolbarToggle:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Small square icon-only button, e.g. the property row remove button. -->
  <Style Selector="Button.iconOnly">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.iconOnly:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- ═══════════════════════════════ icons ═══════════════════════════════ -->

  <!--
    Icons are stroked paths. Stretch=Uniform lets one 24×24 geometry serve every size,
    and the stroke is scaled by the same factor so weight stays even.
  -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Tree icons take their colour from the row, not from a parent button. -->
  <Style Selector="Path.treeIcon">
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Path.treeIcon.accent">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ═══════════════════════════════ badges ═══════════════════════════════ -->

  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="22" />
  </Style>

  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.badge.neutral">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Border.badge.neutral > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="Border.badge.danger > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ════════════════════════════ panels + chrome ════════════════════════════ -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.cardHeader">
    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,6" />
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Vertical hairline used to group toolbar sections. -->
  <Style Selector="Rectangle.toolbarDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="7,4" />
    <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Rectangle.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- ═════════════════════════════ tree view ═════════════════════════════ -->

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- Rounded, inset selection instead of a full-bleed bar. -->
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Margin" Value="2,1" />
  </Style>

  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <!-- A disabled entity is dimmed but still legible; it must stay findable. -->
  <Style Selector="TextBlock.entityTitle.disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Path.treeIcon.disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- ═════════════════════════════ data grid ═════════════════════════════ -->

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="RowHeight" Value="30" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="SeparatorBrush" Value="Transparent" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    DataGridTextColumn clips at the cell edge by default, which cuts glyphs in half and
    reads as a rendering fault. An ellipsis makes truncation look deliberate.
  -->
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ═══════════════════════════════ inputs ═══════════════════════════════ -->

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="TextBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,5" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <!-- ════════════════════════════════ tabs ════════════════════════════════ -->

  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- ═══════════════════════════════ misc ═══════════════════════════════ -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Dialog footers keep a consistent button rhythm. -->
  <Style Selector="StackPanel.dialogButtons > Button">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>

</Styles>
