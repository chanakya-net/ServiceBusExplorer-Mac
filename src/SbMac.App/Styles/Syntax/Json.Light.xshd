<?xml version="1.0"?>
<!-- Read-only JSON highlighting for the message body viewer (light theme). -->
<SyntaxDefinition name="SbJson.Light" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Key" foreground="#0451A5" />
  <Color name="String" foreground="#A31515" />
  <Color name="Number" foreground="#098658" />
  <Color name="Keyword" foreground="#0000FF" />
  <Color name="Punctuation" foreground="#555555" />
  <RuleSet>
    <Rule color="Key">"(?:\\.|[^"\\])*"(?=\s*:)</Rule>
    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Rule color="Number">-?\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b</Rule>
    <Keywords color="Keyword">
      <Word>true</Word>
      <Word>false</Word>
      <Word>null</Word>
    </Keywords>
    <Rule color="Punctuation">[\[\]{}:,]</Rule>
  </RuleSet>
</SyntaxDefinition>
