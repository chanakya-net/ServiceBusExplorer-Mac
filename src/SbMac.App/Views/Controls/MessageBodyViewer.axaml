<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="SbMac.App.Views.Controls.MessageBodyViewer">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="8,4">
      <CheckBox x:Name="WrapToggle" Content="Word wrap" VerticalAlignment="Center" />
      <Button x:Name="OpenFindButton" Content="Find" />
    </StackPanel>
    <TextBlock x:Name="HighlightNotice" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap" Margin="10,4"
               Foreground="{DynamicResource TextSecondaryBrush}"
               AutomationProperties.Name="Highlighting disabled for large body"
               />
    <StackPanel x:Name="FindBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6" IsVisible="False">
      <TextBox x:Name="FindQuery" Width="200" PlaceholderText="Find in body" AutomationProperties.Name="Find in body" />
      <TextBlock x:Name="FindStatus" VerticalAlignment="Center" MinWidth="80" />
      <Button x:Name="PreviousButton" Content="Previous" />
      <Button x:Name="NextButton" Content="Next" />
      <Button x:Name="CloseFindButton" Content="Close" />
    </StackPanel>
  <ae:TextEditor x:Name="Editor"
                 IsReadOnly="True"
                 ShowLineNumbers="False"
                 WordWrap="False"
                 Background="Transparent"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="12.5"
                 Padding="10,8"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</UserControl>
