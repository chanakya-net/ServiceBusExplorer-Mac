<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SbMac.App.ViewModels.Dialogs"
        x:Class="SbMac.App.Views.Dialogs.SendMessageDialog"
        x:DataType="vm:SendMessageViewModel"
        Title="{Binding DialogTitle}" Width="760" Height="700"
        MinWidth="620" MinHeight="400" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="3" Margin="0,0,0,12">
      <TextBlock Text="{Binding DialogTitle}" Classes="title" />
      <TextBlock Classes="tertiary" Text="{Binding SeedDescription}"
                 IsVisible="{Binding SeedDescription, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBlock Classes="caption" Text="BODY" />
        <TextBox x:Name="BodyInput" Classes="mono" Text="{Binding Body}" AcceptsReturn="True" AcceptsTab="True"
                 Height="220" TextWrapping="NoWrap" VerticalContentAlignment="Top" PlaceholderText="{}{ &quot;orderId&quot;: 1 }" />
        <Grid ColumnDefinitions="110,*">
          <TextBlock Classes="fieldLabel" Text="Content type" />
          <TextBox Grid.Column="1" Text="{Binding ContentType}" PlaceholderText="application/json" />
        </Grid>
        <Expander HorizontalAlignment="Stretch" Header="Message metadata" IsExpanded="{Binding IsMetadataExpanded}">
          <StackPanel Spacing="9" Margin="0,10,0,0">
            <Grid ColumnDefinitions="110,*"><TextBlock Classes="fieldLabel" Text="Label" /><TextBox Grid.Column="1" Text="{Binding Subject}" /></Grid>
            <Grid ColumnDefinitions="110,*"><TextBlock Classes="fieldLabel" Text="Correlation ID" /><TextBox Grid.Column="1" Text="{Binding CorrelationId}" /></Grid>
            <Grid ColumnDefinitions="110,*" IsVisible="{Binding ShowServiceBusFields}"><TextBlock Classes="fieldLabel" Text="Session ID" /><TextBox Grid.Column="1" Text="{Binding SessionId}" /></Grid>
            <Grid ColumnDefinitions="110,*"><TextBlock Classes="fieldLabel" Text="Partition key" /><TextBox Grid.Column="1" Text="{Binding PartitionKey}" /></Grid>
            <Grid ColumnDefinitions="110,*" IsVisible="{Binding ShowServiceBusFields}"><TextBlock Classes="fieldLabel" Text="Reply to" /><TextBox Grid.Column="1" Text="{Binding ReplyTo}" /></Grid>
            <Grid ColumnDefinitions="110,*" IsVisible="{Binding ShowServiceBusFields}"><TextBlock Classes="fieldLabel" Text="To" /><TextBox Grid.Column="1" Text="{Binding To}" /></Grid>
          </StackPanel>
        </Expander>
        <Expander HorizontalAlignment="Stretch" Header="Application properties" IsExpanded="{Binding IsPropertiesExpanded}">
          <StackPanel Spacing="8" Margin="0,10,0,0">
            <Button Content="Add property" Command="{Binding AddPropertyCommand}" />
            <ItemsControl ItemsSource="{Binding Properties}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PropertyRowViewModel">
                <Grid ColumnDefinitions="*,6,*,6,Auto" Margin="0,0,0,5">
                  <TextBox Text="{Binding Key}" PlaceholderText="key" /><TextBox Grid.Column="2" Text="{Binding Value}" PlaceholderText="value" />
                  <Button Grid.Column="4" Content="Remove" Command="{Binding $parent[ItemsControl].((vm:SendMessageViewModel)DataContext).RemovePropertyCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
        <Expander HorizontalAlignment="Stretch" Header="Copies and scheduling" IsExpanded="{Binding IsDeliveryExpanded}">
          <StackPanel Spacing="9" Margin="0,10,0,0">
            <Grid ColumnDefinitions="110,*"><TextBlock Classes="fieldLabel" Text="Copies" /><NumericUpDown x:Name="CopiesInput" Grid.Column="1" Minimum="1" Maximum="10000" Increment="1" FormatString="0" Value="{Binding Copies}" /></Grid>
            <CheckBox Content="Replace {n} in the body with the copy number" IsChecked="{Binding NumberCopies}" />
            <CheckBox x:Name="ScheduleToggle" Content="Schedule for later" IsChecked="{Binding Schedule}" IsVisible="{Binding ShowServiceBusFields}" />
            <Grid ColumnDefinitions="110,*,6,Auto" IsVisible="{Binding ShowScheduleFields}"><TextBlock Classes="fieldLabel" Text="Enqueue at" /><DatePicker Grid.Column="1" SelectedDate="{Binding ScheduledDate}" /><TimePicker Grid.Column="3" SelectedTime="{Binding ScheduledTime}" /></Grid>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
      <TextBlock Classes="error" Text="{Binding ValidationError}" IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Classes="dialogButtons" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancel" />
        <Button Classes="primary" Content="Send" Click="OnSend" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
