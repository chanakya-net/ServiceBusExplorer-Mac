<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SbMac.App.ViewModels.Dialogs"
        mc:Ignorable="d"
        x:Class="SbMac.App.Views.Dialogs.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="620" SizeToContent="Height"
        MinHeight="0"
        Opened="OnOpened"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="22" RowDefinitions="*,Auto" RowSpacing="12">
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="16">

    <TextBlock Text="{Binding DialogTitle}" Classes="title" />

    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto">
      <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Display name" />
      <TextBox AutomationProperties.Name="Display name" x:Name="NameField" Grid.Column="1" Text="{Binding Name}" PlaceholderText="contoso-prod" />
    </Grid>

    <!--
      Service picker. Event Hubs and Service Bus namespaces share the same DNS suffix, so
      nothing about a host or connection string reveals which one it is.
    -->
    <Grid ColumnDefinitions="150,*">
      <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Service" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
        <RadioButton GroupName="service" Content="Service Bus"
                     IsChecked="{Binding !UseEventHubs}" />
        <RadioButton GroupName="service" Content="Event Hubs"
                     IsChecked="{Binding UseEventHubs}" />
      </StackPanel>
    </Grid>

    <!-- Auth mode picker. The two field sets below are mutually exclusive. -->
    <Grid ColumnDefinitions="150,*">
      <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Authentication" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
        <RadioButton GroupName="auth" Content="Connection string"
                     IsChecked="{Binding !UseEntraId}" />
        <RadioButton GroupName="auth" Content="Entra ID"
                     IsChecked="{Binding UseEntraId}" />
      </StackPanel>
    </Grid>

    <!-- ───────────────── connection string ───────────────── -->
    <StackPanel Spacing="12" IsVisible="{Binding ShowConnectionStringFields}">
      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Connection string"
                   VerticalAlignment="Top" Margin="0,6,10,0" />
        <TextBox AutomationProperties.Name="Connection string" x:Name="ConnectionStringField" Grid.Column="1"
                 Text="{Binding ConnectionString}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="86"
                 Classes="mono"
                 PlaceholderText="{Binding ConnectionStringPlaceholder}" />
      </Grid>
      <TextBlock Classes="tertiary" Margin="150,0,0,0"
                 TextWrapping="Wrap"
                 Text="Stored in your macOS login keychain, not in SB-Mac's config file." />
    </StackPanel>

    <!-- ───────────────── Entra ID ───────────────── -->
    <StackPanel Spacing="12" IsVisible="{Binding ShowEntraFields}">
      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Namespace" />
        <TextBox AutomationProperties.Name="Namespace" x:Name="FullyQualifiedNamespaceField" Grid.Column="1" Text="{Binding FullyQualifiedNamespace}"
                 PlaceholderText="contoso.servicebus.windows.net" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Credential" />
        <ComboBox AutomationProperties.Name="Credential" Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding CredentialKindLabels}"
                  SelectedIndex="{Binding SelectedCredentialIndex}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Tenant ID" />
        <TextBox AutomationProperties.Name="Tenant ID" x:Name="TenantIdField" Grid.Column="1" Text="{Binding TenantId}" PlaceholderText="optional" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Client ID" />
        <TextBox AutomationProperties.Name="Client ID" x:Name="ClientIdField" Grid.Column="1" Text="{Binding ClientId}" PlaceholderText="optional" />
      </Grid>

      <Grid ColumnDefinitions="150,*" IsVisible="{Binding ShowClientSecretFields}">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Client secret" />
        <TextBox AutomationProperties.Name="Client secret" x:Name="ClientSecretField" Grid.Column="1" Text="{Binding ClientSecret}" PasswordChar="•" />
      </Grid>

      <TextBlock Classes="tertiary" Margin="150,0,0,0"
                 TextWrapping="Wrap"
                 Text="{Binding RoleHint}" />
    </StackPanel>

    <Expander Header="Advanced connection options" IsExpanded="{Binding IsAdvancedExpanded}">
    <StackPanel Spacing="12" Margin="0,12,0,0">
    <!-- Event Hubs -->
    <StackPanel Spacing="12" IsVisible="{Binding ShowEventHubFields}">
      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Event hubs"
                   VerticalAlignment="Top" Margin="0,6,10,0" />
        <TextBox AutomationProperties.Name="Event hubs" Grid.Column="1"
                 Text="{Binding EventHubNames}"
                 AcceptsReturn="True"
                 Height="66"
                 Classes="mono"
                 PlaceholderText="telemetry" />
      </Grid>
      <TextBlock Classes="tertiary" Margin="150,0,0,0"
                 TextWrapping="Wrap"
                 Text="One name per line. Only needed when the hubs can't be listed for you — listing is a management-plane call, so a SAS key can never do it." />

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Consumer group" />
        <TextBox AutomationProperties.Name="Consumer group" Grid.Column="1" Text="{Binding ConsumerGroup}" PlaceholderText="$Default" />
      </Grid>

      <Grid ColumnDefinitions="150,*" IsVisible="{Binding ShowSubscriptionField}">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Subscription ID" />
        <TextBox AutomationProperties.Name="Subscription ID" Grid.Column="1" Text="{Binding SubscriptionId}"
                 PlaceholderText="optional — defaults to your first subscription" />
      </Grid>
    </StackPanel>

    <Grid ColumnDefinitions="150,*">
      <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Transport" />
      <CheckBox Grid.Column="1" Content="Use AMQP over WebSockets (port 443)"
                IsChecked="{Binding UseWebSockets}" />
    </Grid>

    </StackPanel>
    </Expander>

    <TextBlock Classes="error" Text="{Binding ValidationError}"
               IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}" />

  </StackPanel>
  </ScrollViewer>
    <StackPanel Grid.Row="1" Classes="dialogButtons" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="primary" Content="Save" IsDefault="True" Click="OnSave" />
    </StackPanel>

  </Grid>
</Window>
