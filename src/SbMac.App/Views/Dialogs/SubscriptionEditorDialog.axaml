<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SbMac.App.ViewModels.Dialogs"
        mc:Ignorable="d"
        x:Class="SbMac.App.Views.Dialogs.SubscriptionEditorDialog"
        x:DataType="vm:SubscriptionEditorViewModel"
        Title="{Binding DialogTitle}"
        Width="620" Height="600"
        MinWidth="560" MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="22" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Classes="title"
               Margin="0,0,0,16" TextTrimming="CharacterEllipsis" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12">

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Name" />
          <TextBox Grid.Column="1" Text="{Binding Name}" IsEnabled="{Binding IsNew}"
                   PlaceholderText="audit" />
        </Grid>

        <!-- Only offered on create: the default rule can't be replaced atomically later. -->
        <StackPanel Spacing="5" IsVisible="{Binding IsNew}">
          <Grid ColumnDefinitions="190,*">
            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Default rule filter" />
            <TextBox Grid.Column="1" Classes="mono" Text="{Binding DefaultRuleFilter}"
                     PlaceholderText="1=1" />
          </Grid>
          <TextBlock Classes="tertiary" Margin="190,0,0,0"
                     TextWrapping="Wrap"
                     Text="A SQL filter applied to every message on the topic. 1=1 receives everything." />
        </StackPanel>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Max delivery count" />
          <NumericUpDown Grid.Column="1" Minimum="1" Maximum="2000" Increment="1"
                         FormatString="0" Value="{Binding MaxDeliveryCount}" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Lock duration" />
          <TextBox Grid.Column="1" Text="{Binding LockDuration}" PlaceholderText="00:00:30" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Default time to live" />
          <TextBox Grid.Column="1" Text="{Binding DefaultMessageTimeToLive}" PlaceholderText="blank = service default" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Auto-delete on idle" />
          <TextBox Grid.Column="1" Text="{Binding AutoDeleteOnIdle}" PlaceholderText="blank = never" />
        </Grid>

        <Rectangle Classes="divider" Margin="0,6" />

        <TextBlock Classes="caption" Text="BEHAVIOUR" />

        <CheckBox Content="Dead-letter messages when they expire"
                  IsChecked="{Binding DeadLetteringOnMessageExpiration}" />

        <CheckBox Content="Dead-letter messages when a filter throws"
                  IsChecked="{Binding EnableDeadLetteringOnFilterEvaluationExceptions}" />

        <CheckBox Content="Enable batched operations"
                  IsChecked="{Binding EnableBatchedOperations}" />

        <CheckBox Content="Subscription is active (uncheck to disable)"
                  IsChecked="{Binding IsActive}" />

        <CheckBox Content="Requires sessions"
                  IsChecked="{Binding RequiresSession}"
                  IsEnabled="{Binding CanEditCreateOnlySettings}" />

        <TextBlock Classes="tertiary"
                   TextWrapping="Wrap"
                   IsVisible="{Binding !CanEditCreateOnlySettings}"
                   Text="Session support is fixed when the subscription is created." />

        <Rectangle Classes="divider" Margin="0,6" />

        <TextBlock Classes="caption" Text="FORWARDING" />

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Forward to" />
          <TextBox Grid.Column="1" Text="{Binding ForwardTo}" PlaceholderText="another queue or topic" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Forward dead-letters to" />
          <TextBox Grid.Column="1" Text="{Binding ForwardDeadLetteredMessagesTo}" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="User metadata" />
          <TextBox Grid.Column="1" Text="{Binding UserMetadata}" />
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Classes="dialogButtons" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Classes="primary" Content="Save" IsDefault="True" Click="OnSave" IsEnabled="{Binding CanSave}" />
    </StackPanel>

  </Grid>
</Window>
