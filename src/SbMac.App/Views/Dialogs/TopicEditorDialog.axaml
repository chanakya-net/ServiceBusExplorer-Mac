<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SbMac.App.ViewModels.Dialogs"
        mc:Ignorable="d"
        x:Class="SbMac.App.Views.Dialogs.TopicEditorDialog"
        x:DataType="vm:TopicEditorViewModel"
        Title="{Binding DialogTitle}"
        Width="620" Height="640"
        MinWidth="480" MinHeight="400" MaxHeight="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Opened="OnOpened">

  <Grid Margin="22" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Classes="title"
               Margin="0,0,0,16" TextTrimming="CharacterEllipsis" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12">
        <TextBlock Classes="caption" Text="ESSENTIAL" />

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Name" />
          <TextBox AutomationProperties.Name="Name" Grid.Column="1" x:Name="NameField" Text="{Binding Name}" IsEnabled="{Binding IsNew}"
                   PlaceholderText="order-events" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Max size (MB)" />
          <NumericUpDown x:Name="MaxSizeField" AutomationProperties.Name="Max size (MB)" Grid.Column="1" Minimum="1024" Maximum="81920" Increment="1024"
                         FormatString="0" Value="{Binding MaxSizeInMegabytes}" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Default time to live" />
          <TextBox AutomationProperties.Name="Default time to live" Grid.Column="1" x:Name="DefaultMessageTimeToLive" Text="{Binding DefaultMessageTimeToLive}" PlaceholderText="blank = service default" />
        </Grid>

        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                   Text="Durations accept hh:mm:ss, d.hh:mm:ss or ISO 8601 (PT30S)." />
        <Rectangle Classes="divider" Margin="0,6" />
        <Expander HorizontalAlignment="Stretch" Header="Optional behaviour" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsOptionalExpanded}">
          <StackPanel Spacing="12" Margin="0,10,0,0">
            <Grid ColumnDefinitions="190,*">
              <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Auto-delete on idle" />
              <TextBox AutomationProperties.Name="Auto-delete on idle" Grid.Column="1" x:Name="AutoDeleteOnIdle" Text="{Binding AutoDeleteOnIdle}" PlaceholderText="blank = never" />
            </Grid>
            <CheckBox Content="Support ordering" IsChecked="{Binding SupportOrdering}" />
            <CheckBox Content="Enable batched operations" IsChecked="{Binding EnableBatchedOperations}" />
            <CheckBox Content="Topic is active (uncheck to disable)" IsChecked="{Binding IsActive}" />
            <Grid ColumnDefinitions="190,*">
              <TextBlock Grid.Column="0" Classes="fieldLabel" Text="User metadata" />
              <TextBox AutomationProperties.Name="User metadata" Grid.Column="1" Text="{Binding UserMetadata}" />
            </Grid>
          </StackPanel>
        </Expander>
        <Expander HorizontalAlignment="Stretch" Header="Fixed at creation" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsCreationExpanded}">
        <StackPanel Spacing="9">


          <CheckBox Content="Enable partitioning"
                    IsChecked="{Binding EnablePartitioning}"
                    IsEnabled="{Binding CanEditCreateOnlySettings}" />

          <CheckBox Content="Requires duplicate detection"
                    IsChecked="{Binding RequiresDuplicateDetection}"
                    IsEnabled="{Binding CanEditCreateOnlySettings}" />

          <Grid ColumnDefinitions="190,*">
            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Duplicate detection window" />
            <TextBox AutomationProperties.Name="Duplicate detection window" Grid.Column="1" x:Name="DuplicateDetectionHistoryTimeWindow"
                     Text="{Binding DuplicateDetectionHistoryTimeWindow}"
                     IsEnabled="{Binding CanEditCreateOnlySettings}"
                     PlaceholderText="00:10:00" />
          </Grid>

          <TextBlock Classes="tertiary"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !CanEditCreateOnlySettings}"
                     Text="Azure Service Bus fixes these settings when the topic is created. To change them, create a new topic." />
        </StackPanel>

        </Expander>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock Text="{Binding ValidationError}" IsVisible="{Binding !!ValidationError}" TextWrapping="Wrap" />
    <StackPanel Classes="dialogButtons" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Classes="secondary" x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Classes="primary" x:Name="SaveButton" Content="Save" IsDefault="True" Click="OnSave" />
    </StackPanel>
    </StackPanel>

  </Grid>
</Window>
