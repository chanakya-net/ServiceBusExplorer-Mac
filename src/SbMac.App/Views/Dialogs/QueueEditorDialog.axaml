<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SbMac.App.ViewModels.Dialogs"
        mc:Ignorable="d"
        x:Class="SbMac.App.Views.Dialogs.QueueEditorDialog"
        x:DataType="vm:QueueEditorViewModel"
        Title="{Binding DialogTitle}"
        Width="620" Height="640"
        MinWidth="480" MinHeight="400" MaxHeight="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Opened="OnOpened">

  <Grid Margin="22" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Classes="title"
               Margin="0,0,0,16" TextTrimming="CharacterEllipsis" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12">
        <TextBlock Classes="caption" Text="ESSENTIAL" />

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Name" />
          <TextBox AutomationProperties.Name="Name" Grid.Column="1" x:Name="NameField" Text="{Binding Name}" IsEnabled="{Binding IsNew}"
                   PlaceholderText="orders" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Max size (MB)" />
          <NumericUpDown AutomationProperties.Name="Maximum size in megabytes" Grid.Column="1" Minimum="1024" Maximum="81920" Increment="1024"
                         FormatString="0" Value="{Binding MaxSizeInMegabytes}" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Max delivery count" />
          <NumericUpDown AutomationProperties.Name="Maximum delivery count" Grid.Column="1" Minimum="1" Maximum="2000" Increment="1"
                         FormatString="0" Value="{Binding MaxDeliveryCount}" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Lock duration" />
          <TextBox AutomationProperties.Name="Lock Duration" Grid.Column="1" x:Name="LockDuration" Text="{Binding LockDuration}" PlaceholderText="00:00:30" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Default time to live" />
          <TextBox AutomationProperties.Name="Default Message Time To Live" Grid.Column="1" x:Name="DefaultMessageTimeToLive" Text="{Binding DefaultMessageTimeToLive}" PlaceholderText="blank = service default" />
        </Grid>

        <TextBlock Classes="tertiary" TextWrapping="Wrap"
                   Text="Durations accept hh:mm:ss, d.hh:mm:ss or ISO 8601 (PT30S)." />
        <Rectangle Classes="divider" Margin="0,6" />

        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Optional behaviour" IsExpanded="{Binding IsOptionalExpanded}">
          <StackPanel Spacing="12" Margin="0,10,0,0">
        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Auto-delete on idle" />
          <TextBox AutomationProperties.Name="Auto Delete On IDle" Grid.Column="1" x:Name="AutoDeleteOnIdle" Text="{Binding AutoDeleteOnIdle}" PlaceholderText="blank = never" />
        </Grid>





        <CheckBox Content="Dead-letter messages when they expire"
                  IsChecked="{Binding DeadLetteringOnMessageExpiration}" />

        <CheckBox Content="Enable batched operations"
                  IsChecked="{Binding EnableBatchedOperations}" />

        <CheckBox Content="Queue is active (uncheck to disable)"
                  IsChecked="{Binding IsActive}" />



        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Forward to" />
          <TextBox AutomationProperties.Name="Forward To" Grid.Column="1" Text="{Binding ForwardTo}" PlaceholderText="another queue or topic" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Forward dead-letters to" />
          <TextBox AutomationProperties.Name="Forward Dead Lettered Messages To" Grid.Column="1" Text="{Binding ForwardDeadLetteredMessagesTo}" />
        </Grid>

        <Grid ColumnDefinitions="190,*">
          <TextBlock Grid.Column="0" Classes="fieldLabel" Text="User metadata" />
          <TextBox AutomationProperties.Name="User Metadata" Grid.Column="1" Text="{Binding UserMetadata}" />
        </Grid>
          </StackPanel>
        </Expander>
        <Expander x:Name="CreationSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Fixed at creation" IsExpanded="{Binding IsCreationExpanded}">
        <StackPanel Spacing="9">


          <CheckBox Content="Requires sessions"
                    IsChecked="{Binding RequiresSession}"
                    IsEnabled="{Binding CanEditCreateOnlySettings}" />

          <CheckBox Content="Enable partitioning"
                    IsChecked="{Binding EnablePartitioning}"
                    IsEnabled="{Binding CanEditCreateOnlySettings}" />

          <CheckBox Content="Requires duplicate detection"
                    IsChecked="{Binding RequiresDuplicateDetection}"
                    IsEnabled="{Binding CanEditCreateOnlySettings}" />

          <Grid ColumnDefinitions="190,*">
            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Duplicate detection window" />
            <TextBox AutomationProperties.Name="Duplicate Detection History Time Window" Grid.Column="1"
                     x:Name="DuplicateDetectionHistoryTimeWindow" Text="{Binding DuplicateDetectionHistoryTimeWindow}"
                     IsEnabled="{Binding CanEditCreateOnlySettings}"
                     PlaceholderText="00:10:00" />
          </Grid>

          <TextBlock Classes="tertiary"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !CanEditCreateOnlySettings}"
                     Text="Azure Service Bus fixes these settings when the queue is created. To change them, create a new queue." />
        </StackPanel>

        </Expander>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
    <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" />
    <StackPanel Classes="dialogButtons" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Classes="secondary" x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="primary" Content="Save" IsDefault="True" Click="OnSave" />
    </StackPanel>
    </StackPanel>

  </Grid>
</Window>
