<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SbMac.App.ViewModels.Dialogs"
        mc:Ignorable="d"
        x:Class="SbMac.App.Views.Dialogs.RuleEditorDialog"
        x:DataType="vm:RuleEditorViewModel"
        Title="{Binding DialogTitle}"
        Width="620" Height="600" MinWidth="480" MinHeight="360" MaxHeight="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Opened="OnOpened">

  <Grid Margin="22" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Classes="title"
               Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />

    <ScrollViewer Grid.Row="1">
    <StackPanel Spacing="12">
    <TextBlock Classes="caption" Text="ESSENTIAL" />
    <Grid ColumnDefinitions="150,*">
      <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Name" />
      <TextBox AutomationProperties.Name="Name" x:Name="NameField" Grid.Column="1" Text="{Binding Name}" IsEnabled="{Binding IsNew}" />
    </Grid>

    <Grid ColumnDefinitions="150,*">
      <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Filter type" />
      <ComboBox AutomationProperties.Name="Filter type" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding FilterTypes}"
                SelectedIndex="{Binding SelectedFilterIndex}" />
    </Grid>

    <!-- ───────────── SQL filter ───────────── -->
    <StackPanel Spacing="12" IsVisible="{Binding ShowSqlFields}">
      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="SQL expression"
                   VerticalAlignment="Top" Margin="0,6,10,0" />
        <TextBox AutomationProperties.Name="SQL expression" x:Name="SqlExpression" Grid.Column="1" Classes="mono" Text="{Binding SqlExpression}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                 PlaceholderText="region = 'emea' AND priority &gt; 3" />
      </Grid>

      <Expander HorizontalAlignment="Stretch" Header="Optional SQL action" IsExpanded="{Binding IsSqlActionExpanded}" HorizontalContentAlignment="Stretch">
      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="SQL action" />
        <TextBox AutomationProperties.Name="SQL action" Grid.Column="1" Classes="mono" Text="{Binding SqlAction}"
                 PlaceholderText="optional, e.g. SET routed = 'yes'" />
      </Grid>
      </Expander>
    </StackPanel>

    <!-- ───────────── correlation filter ───────────── -->
    <StackPanel Spacing="10" IsVisible="{Binding ShowCorrelationFields}">
      <TextBlock Classes="tertiary" TextWrapping="Wrap"
                 Text="Every value you fill in must match for the rule to fire. Leave a field blank to ignore it." />

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Correlation ID" />
        <TextBox AutomationProperties.Name="Correlation ID" Grid.Column="1" Text="{Binding CorrelationId}" />
      </Grid>

      <Expander HorizontalAlignment="Stretch" Header="Advanced correlation fields" IsExpanded="{Binding IsCorrelationAdvancedExpanded}" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="10" Margin="0,10,0,0">
      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Message ID" />
        <TextBox AutomationProperties.Name="Message ID" Grid.Column="1" Text="{Binding MessageId}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Label" />
        <TextBox AutomationProperties.Name="Subject" Grid.Column="1" Text="{Binding Subject}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="To" />
        <TextBox AutomationProperties.Name="To" Grid.Column="1" Text="{Binding To}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Reply to" />
        <TextBox AutomationProperties.Name="Reply To" Grid.Column="1" Text="{Binding ReplyTo}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Session ID" />
        <TextBox AutomationProperties.Name="Session ID" Grid.Column="1" Text="{Binding SessionId}" />
      </Grid>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Content type" />
        <TextBox AutomationProperties.Name="Content Type" Grid.Column="1" Text="{Binding ContentType}" />
      </Grid>
      </StackPanel>
      </Expander>
    </StackPanel>

    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="8">
    <TextBlock Classes="error" Text="{Binding ValidationError}" IsVisible="{Binding !!ValidationError}" TextWrapping="Wrap" />
    <StackPanel Classes="dialogButtons" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button x:Name="CancelButton" Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="primary" Content="Save" IsDefault="True" Click="OnSave" />
    </StackPanel>
    </StackPanel>

  </Grid>
</Window>
